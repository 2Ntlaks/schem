circuit "Emitter follower"

part B1 battery value=12V
part C1 capacitor value=1u
part C2 capacitor value=100u
part Q1 npn
part R1 resistor value=100k
part R2 resistor value=100k
part R3 resistor value=1k
part R4 resistor value=8
part V1 ac-source

connect C1[1] V1[1]
connect C1[2] Q1[B] R1[2] R2[1]
connect C2[1] Q1[E] R3[1]
connect C2[2] R4[1]
net GND = B1[-] R2[2] R3[2] R4[2] V1[2]
net VCC = B1[+] Q1[C] R1[1]
