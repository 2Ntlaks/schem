circuit "Instrumentation amplifier"

part J1 header label=IN pins: 1:V+/passive 2:V-/passive
part J2 header label=OUT pins: 1:OUT/passive
part R1 resistor value=10k
part R2 resistor value=10k
part R3 resistor value=10k
part R4 resistor value=10k
part R5 resistor value=10k
part R6 resistor value=10k
part RG resistor value=1k
part U1 opamp
part U2 opamp
part U3 opamp

connect J1[1] U1[3]
connect J1[2] U2[3]
connect J2[1] R5[2] U3[1]
connect R1[1] RG[1] U1[2]
connect R1[2] R3[1] U1[1]
connect R2[1] RG[2] U2[2]
connect R2[2] R4[1] U2[1]
connect R3[2] R5[1] U3[2]
connect R4[2] R6[1] U3[3]
net GND = R6[2]
