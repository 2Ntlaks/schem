circuit "Op-amp with push-pull output stage"

part D1 diode
part D2 diode
part Q1 npn
part Q2 pnp
part R1 resistor value=10k
part R2 resistor value=100k
part R3 resistor value=8
part R4 resistor value=4.7k
part R5 resistor value=4.7k
part U1 opamp
part V1 ac-source

connect D1[A] Q1[B] R4[2]
connect D1[K] D2[A] U1[1]
connect D2[K] Q2[B] R5[1]
connect R1[1] V1[1]
connect R1[2] R2[1] U1[2]
net GND = R3[2] U1[3] V1[2]
net OUT = Q1[E] Q2[E] R2[2] R3[1]
net VCC = Q1[C] R4[1]
net VEE = Q2[C] R5[2]
