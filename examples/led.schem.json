{
  "schema": "schem/1.0",
  "meta": {
    "title": "LED with a current-limiting resistor"
  },
  "circuit": {
    "parts": [
      {
        "id": "B1",
        "type": "battery",
        "props": {
          "value": "9V"
        }
      },
      {
        "id": "R1",
