{
  "name": "schem-cli",
  "version": "0.0.1",
  "description": "Turn a JSON netlist into a clean, verified schematic drawing (SVG and PNG). A CLI and an MCP server for AI agents.",
  "keywords": [
    "schematic",
    "circuit",
    "netlist",
    "electronics",
    "svg",
    "png",
    "eda",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "homepage": "https://github.com/2Ntlaks/schem#readme",
  "bugs": {
    "url": "https://github.com/2Ntlaks/schem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2Ntlaks/schem.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "schem": "dist/schem.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/netlist-format.md",
    "docs/parts.md",
    "docs/editing.md",
    "docs/install.md",
    "examples/*.schem.json",
    "examples/README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "pack:smoke": "tsx scripts/pack-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "draw": "tsx scripts/draw.ts",
    "schem": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/main.ts",
    "docs:parts": "tsx scripts/parts-doc.ts",
    "phase0": "tsx scripts/phase0.ts",
    "gates": "tsx scripts/gates.ts",
    "bench": "tsx scripts/bench.ts",
    "showcase": "tsx scripts/showcase.ts",
    "draw:symbols": "tsx scripts/symbols.ts",
    "readme:art": "tsx scripts/readme-art.ts",
    "readme:gallery": "tsx scripts/gallery.ts",
    "web:build": "tsx scripts/web.ts build",
    "web:serve": "tsx scripts/web.ts serve",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/opentype.js": "1.3.8",
    "dejavu-fonts-ttf": "2.37.3",
    "esbuild": "0.25.0",
    "marked": "12.0.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "opentype.js": "1.3.4"
  }
}
